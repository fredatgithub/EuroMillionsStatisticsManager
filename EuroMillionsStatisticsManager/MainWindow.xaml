<Window x:Class="EuroMillionsStatisticsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EuroMillions Statistics Manager"
        Height="600"
        Width="1000"
        MinHeight="400"
        MinWidth="650"
        FontSize="14">
  <Window.Resources>
    <Style TargetType="{x:Type DataGrid}">
      <Setter Property="RowBackground" Value="White" />
      <Setter Property="AlternatingRowBackground" Value="#EAF5FF" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0" Margin="10">
      <TabItem Header="Historique">
        <DataGrid x:Name="Historique"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True" />
      </TabItem>
      <TabItem Header="Boules" Height="20" VerticalAlignment="Bottom">
        <DataGrid x:Name="Statistiques"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding}"
                          EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Numéro de la boule" Binding="{Binding Numero}" />
            <DataGridTextColumn Header="Nombre de sorties" Binding="{Binding NombreDeSorties}" />
            <DataGridTextColumn Header="Pourcentage de sortie" Binding="{Binding PourcentageDeSortie, StringFormat={}{0:F2} %}" />
            <DataGridTextColumn Header="Date de la dernière sortie" Binding="{Binding DerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernière sortie" Binding="{Binding AvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-avant-dernière sortie" Binding="{Binding AvantAvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de la 4e dernière sortie" Binding="{Binding QuatriemeDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="2 boules">
        <DataGrid x:Name="StatistiquesPairesBoules"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding}"
                          EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Paire de boules" Binding="{Binding Paire}" />
            <DataGridTextColumn Header="Nombre de sorties" Binding="{Binding NombreDeSorties}" />
            <DataGridTextColumn Header="Pourcentage de sortie" Binding="{Binding PourcentageDeSortie, StringFormat={}{0:F2} %}" />
            <DataGridTextColumn Header="Date de la dernière sortie" Binding="{Binding DerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernière sortie" Binding="{Binding AvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-avant-dernière sortie" Binding="{Binding AvantAvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de la 4e dernière sortie" Binding="{Binding QuatriemeDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="3 boules">
        <DataGrid x:Name="StatistiquesTripletsBoules"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding}"
                          EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Triplet de boules" Binding="{Binding Triplet}" />
            <DataGridTextColumn Header="Nombre de sorties" Binding="{Binding NombreDeSorties}" />
            <DataGridTextColumn Header="Pourcentage de sortie" Binding="{Binding PourcentageDeSortie, StringFormat={}{0:F2} %}" />
            <DataGridTextColumn Header="Date de la dernière sortie" Binding="{Binding DerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernière sortie" Binding="{Binding AvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-avant-dernière sortie" Binding="{Binding AvantAvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de la 4e dernière sortie" Binding="{Binding QuatriemeDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="4 boules">
        <DataGrid x:Name="StatistiquesQuadrupletsBoules"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding}"
                          EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Combinaison de 4 boules" Binding="{Binding Quadruplet}" />
            <DataGridTextColumn Header="Nombre de sorties" Binding="{Binding NombreDeSorties}" />
            <DataGridTextColumn Header="Pourcentage de sortie" Binding="{Binding PourcentageDeSortie, StringFormat={}{0:F2} %}" />
            <DataGridTextColumn Header="Date de la dernière sortie" Binding="{Binding DerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernière sortie" Binding="{Binding AvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-avant-dernière sortie" Binding="{Binding AvantAvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de la 4e dernière sortie" Binding="{Binding QuatriemeDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="5 boules">
        <DataGrid x:Name="StatistiquesQuintupletsBoules"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding}"
                          EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Combinaison de 5 boules" Binding="{Binding Quintuplet}" />
            <DataGridTextColumn Header="Nombre de sorties" Binding="{Binding NombreDeSorties}" />
            <DataGridTextColumn Header="Pourcentage de sortie" Binding="{Binding PourcentageDeSortie, StringFormat={}{0:F2} %}" />
            <DataGridTextColumn Header="Date de la dernière sortie" Binding="{Binding DerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernière sortie" Binding="{Binding AvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-avant-dernière sortie" Binding="{Binding AvantAvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de la 4e dernière sortie" Binding="{Binding QuatriemeDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Etoiles">
        <DataGrid x:Name="StatistiquesEtoiles"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding}"
                          EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Numéro de l’étoile" Binding="{Binding Numero}" />
            <DataGridTextColumn Header="Nombre de sorties" Binding="{Binding NombreDeSorties}" />
            <DataGridTextColumn Header="Pourcentage de sortie" Binding="{Binding PourcentageDeSortie, StringFormat={}{0:F2} %}" />
            <DataGridTextColumn Header="Date de la dernière sortie" Binding="{Binding DerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernière sortie" Binding="{Binding AvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-avant-dernière sortie" Binding="{Binding AvantAvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de la 4e dernière sortie" Binding="{Binding QuatriemeDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="2 étoiles">
        <DataGrid x:Name="StatistiquesPairesEtoiles"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding}"
                          EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Couple d’étoiles" Binding="{Binding Couple}" />
            <DataGridTextColumn Header="Nombre de sorties" Binding="{Binding NombreDeSorties}" />
            <DataGridTextColumn Header="Pourcentage de sortie" Binding="{Binding PourcentageDeSortie, StringFormat={}{0:F2} %}" />
            <DataGridTextColumn Header="Date de la dernière sortie" Binding="{Binding DerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernière sortie" Binding="{Binding AvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-avant-dernière sortie" Binding="{Binding AvantAvantDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de la 4e dernière sortie" Binding="{Binding QuatriemeDerniereSortie, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="PoidsBoules">
        <DataGrid x:Name="PoidsBoules"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Tirage" Binding="{Binding Tirage}" />
            <DataGridTextColumn Header="Poids des boules" Binding="{Binding PoidsDesBoules}" />
            <DataGridTextColumn Header="Poids des étoiles" Binding="{Binding PoidsDesEtoiles}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="PoidsBoulesStatistiques">
        <DataGrid x:Name="PoidsBoulesStatistiques"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Poids du tirage" Binding="{Binding Weight}" />
            <DataGridTextColumn Header="Nombre de tirages" Binding="{Binding Count}" />
            <DataGridTextColumn Header="Date du dernier tirage" Binding="{Binding Latest, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernier tirage" Binding="{Binding Previous, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="PoidsEtoilesStatistiques">
        <DataGrid x:Name="PoidsEtoilesStatistiques"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Poids du tirage" Binding="{Binding Weight}" />
            <DataGridTextColumn Header="Nombre de tirages" Binding="{Binding Count}" />
            <DataGridTextColumn Header="Date du dernier tirage" Binding="{Binding Latest, StringFormat={}{0:dd/MM/yyyy}}" />
            <DataGridTextColumn Header="Date de l’avant-dernier tirage" Binding="{Binding Previous, StringFormat={}{0:dd/MM/yyyy}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="GraphiquePoids">
        <Canvas x:Name="GraphiquePoidsCanvas"
                Background="White"
                SizeChanged="GraphiquePoidsCanvas_SizeChanged" />
      </TabItem>
      <TabItem Header="GraphiquePoidsEtoiles">
        <Canvas x:Name="GraphiquePoidsEtoilesCanvas"
                Background="White"
                SizeChanged="GraphiquePoidsEtoilesCanvas_SizeChanged" />
      </TabItem>
      <TabItem Header="Estimation">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Background="#FFFFDBB8" Padding="18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="Générer" Click="GenerateDraw_Click" Padding="12,4" Margin="0,0,18,0" />
                <Button Content="Génération optimisée" Click="GenerateOptimizedDraw_Click" Padding="12,4" />
                <TextBlock x:Name="EstimationStatus" VerticalAlignment="Center" Margin="18,0,0,0" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock x:Name="BallSelectionCount" Text="0 boule sur 5 sélectionnées" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="Boules" FontWeight="Bold" Margin="0,0,0,8" />
                <UniformGrid x:Name="BallNumberPanel" Columns="10" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock x:Name="StarSelectionCount" Text="0 étoile sur 2 sélectionnées" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="Étoiles" FontWeight="Bold" Margin="0,0,0,8" />
                <UniformGrid x:Name="StarNumberPanel" Columns="3" />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0">
                <TextBlock x:Name="BallWeightResult" FontWeight="Bold" Margin="0,4" />
                <TextBlock x:Name="StarWeightResult" FontWeight="Bold" Margin="0,4" />
                <TextBlock x:Name="BallDistributionResult" FontWeight="Bold" Margin="0,4" TextWrapping="Wrap" />
                <TextBlock x:Name="HistoryMatchResult" FontWeight="Bold" Margin="0,4" TextWrapping="Wrap" />
                <TextBlock x:Name="OptimizedScoreResult" FontWeight="Bold" Margin="0,4" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Log">
        <TextBox x:Name="LogText"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="16" />
      </TabItem>
    </TabControl>

    <StatusBar Grid.Row="1">
      <TextBlock x:Name="StatusText" Text="Chargement de l’historique..." />
    </StatusBar>
  </Grid>
</Window>
