<Window x:Class="EuroMillionsStatisticsManager.PleaseWait"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veuillez patienter"
        Width="420"
        Height="150"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
  <StackPanel VerticalAlignment="Center" Margin="24">
    <TextBlock Text="Veuillez patienter pendant le chargement de l'application"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,0,0,16" />
    <ProgressBar IsIndeterminate="True" Height="12" />
  </StackPanel>
</Window>
